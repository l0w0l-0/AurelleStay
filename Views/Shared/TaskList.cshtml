@model pameka_7033_l005.ViewModels.TaskListViewModel
@using pameka_7033_l005.Helpers
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Adminlayout";
}

<div class="dashboard">
    <h1>@Model.Title</h1>
    <partial name="_Flash" />
    <p>@Model.Description</p>

    <div class="staff-card">
        @if (!Model.Rows.Any())
        {
            <div class="cx-empty"><b>@Model.EmptyText</b><span>งานใหม่จะแสดงที่นี่ทันทีที่มีลูกค้าเข้าพักหรือสั่งบริการ</span></div>
        }
        else
        {
            <div class="staff-table-wrap">
                <table class="table table-bordered staff-table">
                    <thead>
                        <tr><th>ห้อง</th><th>รายละเอียด</th><th>สถานะ</th>@if (Model.Delivery) { <th>@(Model.ShowDone ? "ใช้เวลา" : "รอมาแล้ว")</th> }
                            @if (Model.ShowDone) { <th>ผู้ทำ</th><th>เสร็จเมื่อ</th> } else { <th>จัดการ</th> }</tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="@(r.Late ? "dv-late" : "") @(r.Urgent ? "dv-urgent" : "")">
                            <td>@r.RoomNo</td>
                            <td>
                                @if (r.Urgent) { <span class="dv-tag dv-tag--urgent">ด่วน</span> }
                                @r.Detail
                                @if (r.Source != null) { <small class="dv-sub">@r.Source@(r.Guest != null ? " · คุณ" + r.Guest : "")</small> }
                                @if (!string.IsNullOrEmpty(r.Note)) { <small class="dv-sub">หมายเหตุ: @r.Note</small> }
                                @if (r.Missed > 0) { <small class="dv-sub dv-sub--warn">@Model.NotHomeLabel @r.Missed ครั้ง</small> }
                            </td>
                            <td><span class="cx-badge cx-badge--@r.Status">@(r.StatusText ?? ThaiLabels.TaskStatus(r.Status))</span></td>
                            @if (Model.Delivery)
                            {
                                <td class="dv-time">@(r.Minutes is int m ? (m >= 60 ? $"{m / 60} ชม. {m % 60} นาที" : $"{m} นาที") : "–")</td>
                            }
                            @if (Model.ShowDone)
                            {
                                <td>@r.Assignee</td>
                                <td>@(r.DoneAt?.ToString("dd/MM/yyyy HH:mm"))</td>
                            }
                            else
                            {
                                <td>
                                    @if (r.CanTake)
                                    {
                                        <form asp-action="Take" method="post" class="staff-inline">
                                            <input type="hidden" name="id" value="@r.TaskId" />
                                            @if (Model.KindField) { <input type="hidden" name="kind" value="@r.Kind" /> }
                                            <button type="submit" class="cx-btn cx-btn--small">@Model.TakeLabel</button>
                                        </form>
                                    }
                                    @if (r.CanFinish)
                                    {
                                        <form asp-action="Finish" method="post" class="staff-inline">
                                            <input type="hidden" name="id" value="@r.TaskId" />
                                            @if (Model.KindField) { <input type="hidden" name="kind" value="@r.Kind" /> }
                                            <button type="submit" class="cx-btn cx-btn--small">@Model.FinishLabel</button>
                                        </form>
                                        @if (Model.Delivery)
                                        {
                                            <form asp-action="@Model.NotHomeAction" method="post" class="staff-inline">
                                                <input type="hidden" name="id" value="@r.TaskId" />@if (Model.KindField) { <input type="hidden" name="kind" value="@r.Kind" /> }
                                                <button type="submit" class="cx-btn cx-btn--ghost cx-btn--small">@Model.NotHomeLabel</button>
                                            </form>
                                        }
                                    }
                                    @if (Model.Delivery)
                                    {
                                        <form asp-action="Urgent" method="post" class="staff-inline">
                                            <input type="hidden" name="id" value="@r.TaskId" />@if (Model.KindField) { <input type="hidden" name="kind" value="@r.Kind" /> }
                                            <button type="submit" class="cx-btn cx-btn--ghost cx-btn--small">@(r.Urgent ? "ยกเลิกด่วน" : "ตั้งเป็นด่วน")</button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
