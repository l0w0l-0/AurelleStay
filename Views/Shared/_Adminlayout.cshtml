    // ไอคอนเส้นบาง (SVG path) ตามเมนู — key = Controller.Action
    var icons = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Admin.Index"] = "M4 13h6V4H4zM14 20h6v-9h-6zM4 20h6v-3H4zM14 4v3h6V4z",
        ["AdminRooms.Index"] = "M3 18V8m0 6h18v4M21 18v-6a3 3 0 0 0-3-3h-7v5M7 11.5a1.5 1.5 0 1 0 0-.01",
        ["AdminBookings.Index"] = "M5 4h14v17l-3.5-2-3.5 2-3.5-2L5 21zM9 9h6M9 13h6",
        ["FrontDesk.WalkIn"] = "M12 5v14M5 12h14",
        ["FrontDesk.Activities"] = "M4 6h16v14H4zM4 10h16M9 3v4M15 3v4M8 14h3v3H8z",
        ["AdminActivities.Index"] = "M12 3l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L4.8 8.3l5-.7z",
        ["Rooms.Availability"] = "M4 6h16v14H4zM4 10h16M9 3v4M15 3v4",
        ["FrontDesk.Availability"] = "M4 6h16v14H4zM4 10h16M9 3v4M15 3v4",
        ["Account.UserList"] = "M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM3 20a6 6 0 0 1 12 0M16 4.5a3.5 3.5 0 0 1 0 6.5M18 14a5 5 0 0 1 3 6",
        ["Account.LoginHistory"] = "M12 7v5l3 2M4 12a8 8 0 1 0 2.3-5.6M4 4v3h3",
        ["AdminServices.Index"] = "M5 11h14v2a7 7 0 0 1-14 0zM9 4c0 1.5 1 1.5 1 3M13 4c0 1.5 1 1.5 1 3",
        ["AdminPromotions.Index"] = "M20 12.5 12.5 20a1.4 1.4 0 0 1-2 0L4 13.5V4h9.5l6.5 6.5a1.4 1.4 0 0 1 0 2zM8.5 8.5h.01",
        ["AdminMessages.Index"] = "M4 6h16v12H4zM4 7l8 6 8-6",
        ["AdminReviews.Index"] = "M12 4l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 16.4l-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z",
        ["AdminStaff.Index"] = "M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM5 20a7 7 0 0 1 14 0M12 14l1 2-1 3-1-3z",
        ["AdminReports.Index"] = "M4 20V10M10 20V4M16 20v-7M22 20H2",
        ["AdminReports.Delivery"] = "M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 1 0 0-.01M17 19a2 2 0 1 0 0-.01",
        ["AdminAudit.Index"] = "M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6zM9 12l2 2 4-4",
        ["AdminAudit.SystemStatus"] = "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3",
        ["Accounting.Index"] = "M4 6h16v12H4zM4 10h16M8 15h3",
        ["Accounting.Refunds"] = "M4 10a8 8 0 1 1 2 6M4 16v-6h6",
        ["Accounting.History"] = "M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z",
        ["Accounting.Expenses"] = "M4 20V10M10 20V4M16 20v-7M22 20H2",
        ["FrontDesk.Index"] = "M15 4h4v16h-4M10 16l4-4-4-4M14 12H4",
        ["FrontDesk.Rooms"] = "M4 21V5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v16M16 9h3a1 1 0 0 1 1 1v11M2 21h20M8 8h4M8 12h4",
        ["Delivery.Index"] = "M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 1 0 0-.01M17 19a2 2 0 1 0 0-.01",
        ["Delivery.Done"] = "M5 12l5 5L20 7",
        ["Housekeeping.Index"] = "M12 3v9M8 12h8l1 9H7zM10 16v5M14 16v5",
        ["Housekeeping.Done"] = "M5 12l5 5L20 7",
        ["Housekeeping.Issues"] = "M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z",
        ["AdminReports.Housekeeping"] = "M12 3v9M8 12h8l1 9H7zM10 16v5M14 16v5",
