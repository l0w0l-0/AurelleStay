@using System.Security.Claims
@using pameka_7033_l005.Helpers
@inject pameka_7033_l005.Models.Csi402dbContext MenuDb
@{
    // เลย์เอาต์หลังบ้านเดียว ใช้ทั้งผู้จัดการและพนักงานทุกฝ่าย: ต่างกันแค่เมนูด้านข้างตามบทบาท
    Layout = null;
    var ui = UiPrefs.From(Context.Request);
    var role = User.FindFirstValue(ClaimTypes.Role);
    var roleLabel = RoleNames.Label(role);
    var isAdmin = string.Equals(role, RoleNames.Admin, StringComparison.OrdinalIgnoreCase);
    var (homeController, homeAction) = RoleNames.HomeFor(role);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var counts = await BookingQueries.MenuCountsAsync(MenuDb, role);

    // เมนูผู้จัดการ: (หัวข้อ, [(controller, action, ชื่อเมนู)])
    var adminMenu = new[]
    {
        ("DASHBOARD", new[] { ("Admin", "Index", "Dashboard") }),
        ("HOTEL MANAGEMENT", new[] { ("AdminRooms", "Index", "จัดการห้องพัก"), ("AdminBookings", "Index", "การจองห้องพัก"), ("FrontDesk", "WalkIn", "จองห้องให้ลูกค้า"), ("FrontDesk", "Activities", "กิจกรรมวันนี้"), ("Rooms", "Availability", "ปฏิทินห้องว่าง"), ("Account", "UserList", "ลูกค้า / ผู้ใช้"), ("Account", "LoginHistory", "ประวัติเข้าสู่ระบบ") }),
        ("SERVICES", new[] { ("AdminServices", "Index", "บริการเสริม / อาหาร"), ("AdminActivities", "Index", "กิจกรรม"), ("AdminPromotions", "Index", "โปรโมชั่น"), ("AdminReviews", "Index", "รีวิวจากลูกค้า"), ("AdminMessages", "Index", "ข้อความจากลูกค้า") }),
        ("STAFF", new[] { ("AdminStaff", "Index", "จัดการพนักงาน") }),
        ("SYSTEM", new[] { ("AdminReports", "Index", "รายงาน"), ("AdminReports", "Delivery", "สถิติฝ่ายส่งของ"), ("AdminReports", "Housekeeping", "แม่บ้าน / แจ้งซ่อม"), ("AdminAudit", "Index", "บันทึกกิจกรรม"), ("AdminAudit", "SystemStatus", "สถานะระบบ / สำรองข้อมูล") })
