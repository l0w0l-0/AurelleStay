@model pameka_7033_l005.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "ลืมรหัสผ่าน";
    Layout = "_loginLayout";
}
<section class="auth-page">
    <a asp-controller="Account" asp-action="Login" class="auth-back"><span aria-hidden="true">←</span> กลับไปหน้าเข้าสู่ระบบ</a>
    <div class="auth-container">
        <div class="auth-ad auth-ad--photo">
            <img src="~/images/rooms/deluxe-twin.jpg" alt="" width="1200" height="800" />
            <div class="cx-auth-art">
                <p class="cx-eyebrow">Account recovery</p>
                <h1>Aurelle<span>Stay</span></h1>
                <p>ตั้งรหัสผ่านใหม่ได้เองผ่านอีเมลที่ใช้สมัคร ภายในไม่กี่นาที</p>
                <ul class="auth-perks">
                    <li>ลิงก์ใช้ได้ครั้งเดียว หมดอายุใน 30 นาที</li>
                    <li>ตั้งรหัสใหม่แล้ว ทุกอุปกรณ์ที่ล็อกอินค้างไว้จะออกจากระบบ</li>
                </ul>
            </div>
        </div>
        <div class="auth-card">
            <h2 class="auth-title">ลืมรหัสผ่าน</h2>
            @if (Model.Sent)
            {
                <div class="auth-alert success" role="status">
                    ถ้า <b>@Model.Email</b> เป็นอีเมลที่สมัครไว้ เราได้ส่งลิงก์ตั้งรหัสผ่านใหม่ไปแล้ว กรุณาตรวจกล่องจดหมาย (รวมถึงโฟลเดอร์สแปม) ลิงก์ใช้ได้ 30 นาที
                </div>
                <p class="auth-help"><a asp-action="ForgotPassword">ส่งอีกครั้ง</a> · <a asp-action="Login">กลับไปเข้าสู่ระบบ</a></p>
            }
            else
            {
                @if (Model.Error != null)
                {
                    <div class="auth-alert error" role="alert">@Model.Error</div>
                }
                <form class="auth-form" asp-action="ForgotPassword" method="post" style="display:flex">
                    <p class="auth-help" style="text-align:left;margin:0">กรอกอีเมลที่ใช้สมัครสมาชิก ระบบจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปให้</p>
                    <div class="auth-input-group">
                        <input type="email" asp-for="Email" placeholder="อีเมล" autocomplete="email" aria-label="อีเมล" />
                        <span asp-validation-for="Email" class="auth-error"></span>
                    </div>
                    <button type="submit" class="btn-primary">ส่งลิงก์ตั้งรหัสผ่านใหม่</button>
                </form>
            }
        </div>
    </div>
</section>
