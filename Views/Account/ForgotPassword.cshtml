@model pameka_7033_l005.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "ลืมรหัสผ่าน";
    Layout = "_loginLayout";
}
<section class="auth-page">
    <a asp-action="Login" class="auth-back"><span aria-hidden="true">←</span> กลับไปเข้าสู่ระบบ</a>
    <div class="auth-container auth-container--single">
        <div class="auth-card">
            <h1 class="auth-title">ลืมรหัสผ่าน</h1>
            <p class="auth-help">กรอกอีเมลที่ใช้สมัคร เราจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ให้ (ลิงก์ใช้ได้ 30 นาที ครั้งเดียว)</p>
            @if (Model.Done != null)
            {
                <div class="auth-alert success" role="status">@Model.Done</div>
            }
            <form class="auth-form" asp-action="ForgotPassword" method="post" style="display:flex">
                <div class="auth-input-group">
                    <input type="email" asp-for="Email" placeholder="อีเมล" autocomplete="email" required />
                    <span asp-validation-for="Email" class="auth-error"></span>
                </div>
                <button type="submit" class="btn-primary">ส่งลิงก์ตั้งรหัสผ่านใหม่</button>
                <p class="auth-help">ไม่ได้รับอีเมล? ตรวจโฟลเดอร์สแปม หรือ <a href="@Url.Action("About", "Home", new { topic = "PASSWORD" })#contact">ติดต่อโรงแรม</a></p>
            </form>
        </div>
    </div>
</section>
