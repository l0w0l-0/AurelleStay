@model pameka_7033_l005.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "ตั้งรหัสผ่านใหม่";
    Layout = "_loginLayout";
}
<section class="auth-page">
    <a asp-action="Login" class="auth-back"><span aria-hidden="true">←</span> กลับไปเข้าสู่ระบบ</a>
    <div class="auth-container auth-container--single">
        <div class="auth-card">
            <h1 class="auth-title">ตั้งรหัสผ่านใหม่</h1>
            @if (Model.Invalid)
            {
                <div class="auth-alert error" role="alert">ลิงก์นี้หมดอายุ ถูกใช้ไปแล้ว หรือไม่ถูกต้อง</div>
                <p class="auth-help"><a asp-action="ForgotPassword">ขอลิงก์ใหม่</a></p>
            }
            else
            {
                <p class="auth-help">บัญชี <b>@Model.Email</b> · รหัสผ่านยาวอย่างน้อย 8 ตัว มีทั้งตัวอักษรและตัวเลข</p>
                <form class="auth-form" asp-action="ResetPassword" method="post" style="display:flex">
                    <input type="hidden" asp-for="Token" />
                    <input type="text" name="username" value="@Model.Email" autocomplete="username" hidden />
                    <div class="auth-input-group">
                        <input type="password" asp-for="NewPassword" placeholder="รหัสผ่านใหม่" autocomplete="new-password" required />
                        <span asp-validation-for="NewPassword" class="auth-error"></span>
                    </div>
                    <div class="auth-input-group">
                        <input type="password" asp-for="ConfirmPassword" placeholder="ยืนยันรหัสผ่านใหม่" autocomplete="new-password" required />
                        <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
                    </div>
                    <button type="submit" class="btn-primary">บันทึกรหัสผ่านใหม่</button>
                </form>
            }
        </div>
    </div>
</section>
