@model pameka_7033_l005.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "ตั้งรหัสผ่านใหม่";
    Layout = "_loginLayout";
    var valid = !string.IsNullOrEmpty(Model.Token);
}
<section class="auth-page">
    <a asp-controller="Account" asp-action="Login" class="auth-back"><span aria-hidden="true">←</span> กลับไปหน้าเข้าสู่ระบบ</a>
    <div class="auth-container">
        <div class="auth-ad auth-ad--photo">
            <img src="~/images/rooms/family-suite.jpg" alt="" width="1200" height="800" />
            <div class="cx-auth-art">
                <p class="cx-eyebrow">Account recovery</p>
                <h1>Aurelle<span>Stay</span></h1>
                <p>ตั้งรหัสผ่านใหม่อย่างน้อย 8 ตัว มีทั้งตัวอักษรและตัวเลข</p>
            </div>
        </div>
        <div class="auth-card">
            <h2 class="auth-title">ตั้งรหัสผ่านใหม่</h2>
            @if (!valid)
            {
                <div class="auth-alert error" role="alert">ลิงก์นี้หมดอายุ ถูกใช้ไปแล้ว หรือไม่ถูกต้อง กรุณาขอลิงก์ใหม่</div>
                <p class="auth-help"><a asp-action="ForgotPassword">ขอลิงก์ตั้งรหัสผ่านใหม่</a></p>
            }
            else
            {
                <form class="auth-form" asp-action="ResetPassword" method="post" style="display:flex">
                    <input type="hidden" asp-for="Token" />
                    <p class="auth-help" style="text-align:left;margin:0">บัญชี <b>@Model.Email</b></p>
                    <input type="email" value="@Model.Email" autocomplete="username" hidden aria-hidden="true" tabindex="-1" />
                    <div class="auth-input-group">
                        <input type="password" asp-for="NewPassword" placeholder="รหัสผ่านใหม่" autocomplete="new-password" aria-label="รหัสผ่านใหม่" />
                        <span asp-validation-for="NewPassword" class="auth-error"></span>
                    </div>
                    <div class="auth-input-group">
                        <input type="password" asp-for="ConfirmPassword" placeholder="ยืนยันรหัสผ่านใหม่" autocomplete="new-password" aria-label="ยืนยันรหัสผ่านใหม่" />
                        <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
                    </div>
                    <button type="submit" class="btn-primary">บันทึกรหัสผ่านใหม่</button>
                </form>
            }
        </div>
    </div>
</section>
