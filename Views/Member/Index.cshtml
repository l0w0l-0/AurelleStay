@model pameka_7033_l005.ViewModels.MemberDashboardViewModel
@using pameka_7033_l005.Helpers
@{
    ViewData["Title"] = "หน้าสมาชิก";
    ViewData["NoIndex"] = true;
    Layout = "_Homelayout";
    string[] months = { "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค." };
    string D(DateOnly d) => $"{d.Day} {months[d.Month - 1]} {d.Year}";
    var hour = pameka_7033_l005.Helpers.AppClock.Now.Hour;
    var greet = hour < 12 ? "สวัสดีตอนเช้า" : hour < 17 ? "สวัสดีตอนบ่าย" : "สวัสดีตอนเย็น";
    var n = Model.Next;
}

<section class="mb-hero">
    <div class="cx-wrap mb-hero__grid">
        <div>
            <p class="cx-eyebrow">Member Lounge</p>
            <h1>@greet<br /><em>คุณ@(Model.FirstName)</em></h1>
            <p class="mb-since">สมาชิก AurelleStay ตั้งแต่ @D(DateOnly.FromDateTime(Model.MemberSince))</p>
        </div>
        <dl class="mb-stats">
            <div><dt>เข้าพักแล้ว</dt><dd>@Model.Stays<small> ครั้ง</small></dd></div>
            <div><dt>รวม</dt><dd>@Model.Nights<small> คืน</small></dd></div>
            <div><dt>ประหยัดไป</dt><dd>@Model.Saved.ToString("N0")<small> บาท</small></dd></div>
        </dl>
    </div>
</section>

<div class="cx-wrap mb-body">
    <partial name="_MemberNav" />
    <partial name="_Flash" />

    @if (Model.StayBookingId is int stayNow)
    {
        <div class="mb-alert mb-alert--stay" role="status" data-alert-key="stay-@stayNow">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V8l9-5 9 5v13M9 21v-6h6v6" /></svg>
            <p><b>กำลังเข้าพัก ห้อง @string.Join(", ", Model.StayRooms.Select(r => r.RoomNo))</b> ต้องการอะไรเพิ่ม พนักงานนำไปส่งถึงห้อง</p>
            <a href="#mb-req" class="cx-btn cx-btn--small">ขอของใช้เพิ่ม</a>
            <a href="#mb-svc" class="cx-btn cx-btn--ghost cx-btn--small">สั่งบริการ / ดูยอด</a>
            <a href="#mb-clean" class="cx-btn cx-btn--ghost cx-btn--small">ขอทำความสะอาด</a>
            <button type="button" class="mb-alert__x" data-dismiss-alert aria-label="ปิดแถบนี้">×</button>
        </div>
    }

    @foreach (var b in Model.NeedAction)
    {
        <div class="mb-alert" role="status" data-alert-key="pay-@b.BookingId-@(b.LastRejectedAt?.Ticks ?? 0)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 16.5h.01" /></svg>
            <p>
                <b>การจอง #@b.BookingId @(b.LastRejectedAt != null ? "— สลิปถูกปฏิเสธ แนบใหม่" : "— รอชำระเงิน")</b>
                ภายใน @BookingExpiry.Deadline(b.BookedAt, b.CheckIn, b.LastRejectedAt).ToString("dd/MM HH:mm") น. มิฉะนั้นระบบจะยกเลิกอัตโนมัติ
            </p>
            <a asp-controller="Booking" asp-action="Pay" asp-route-id="@b.BookingId" class="cx-btn cx-btn--small">ชำระเงิน</a>
            <button type="button" class="mb-alert__x" data-dismiss-alert aria-label="ปิดแถบนี้">×</button>
        </div>
    }

    <div class="mb-grid">
      <div class="mb-main">
        <section class="mb-next" aria-labelledby="mb-next-h">
            <p class="mb-kicker">Your next stay</p>
            <h2 id="mb-next-h">การเข้าพักครั้งถัดไป</h2>
            @if (n == null)
            {
                <div class="mb-empty">
                    <p>ยังไม่มีการเข้าพักที่กำลังจะมาถึง</p>
                    <a asp-controller="Rooms" asp-action="Index" class="cx-btn cx-btn--sun">ค้นหาห้องว่าง</a>
                </div>
            }
            else
            {
                var days = n.CheckIn.DayNumber - Model.Today.DayNumber;
                var nights = n.CheckOut.DayNumber - n.CheckIn.DayNumber;
                <div class="mb-count@(n.Status == "CHECKED_IN" || days <= 0 ? " mb-count--text" : "")">
                    @if (n.Status == "CHECKED_IN") { <b>กำลังเข้าพัก</b><span>เช็คเอาท์ @D(n.CheckOut)</span> }
                    else if (days <= 0) { <b>วันนี้</b><span>พร้อมต้อนรับคุณ</span> }
                    else { <b>@days</b><span>วันก่อนเข้าพัก</span> }
                </div>
                <div class="mb-trip">
                    <div><small>เช็คอิน</small><b>@D(n.CheckIn)</b></div>
                    <span class="mb-trip__line" aria-hidden="true"><i>@nights คืน</i></span>
                    <div><small>เช็คเอาท์</small><b>@D(n.CheckOut)</b></div>
                </div>
                <p class="mb-rooms">การจอง #@n.BookingId@(n.Rooms.Any() ? " · ห้อง " + string.Join(", ", n.Rooms) : "") <span class="cx-badge cx-badge--@n.Status">@ThaiLabels.BookingStatus(n.Status)</span></p>
                <div class="mb-actions">
                    @if (BookingWorkflow.CanPay(n.Status, n.Flags)) { <a asp-controller="Booking" asp-action="Pay" asp-route-id="@n.BookingId" class="cx-btn cx-btn--sun">ชำระเงิน</a> }
                    <a href="/Booking/Details/@n.BookingId" class="cx-btn cx-btn--light">รายละเอียด</a>
                    <a href="/Booking/Document/@n.BookingId?kind=confirmation" class="cx-btn cx-btn--light">ใบยืนยันการจอง</a>
                </div>
            }
        </section>
        <div class="mb-pair">
            <section class="mb-card" aria-labelledby="mb-up-h">
                <h2 id="mb-up-h">การจองอื่นที่กำลังจะมาถึง</h2>
                @if (!Model.Upcoming.Any()) { <p class="mb-muted">ไม่มี</p> }
                <ul class="mb-list">
                    @foreach (var b in Model.Upcoming)
                    {
                        <li><a href="/Booking/Details/@b.BookingId"><b>@D(b.CheckIn)</b><span>#@b.BookingId · @(b.CheckOut.DayNumber - b.CheckIn.DayNumber) คืน</span></a><span class="cx-badge cx-badge--@b.Status">@ThaiLabels.BookingStatus(b.Status)</span></li>
                    }
                </ul>
                <a asp-controller="Booking" asp-action="MyBookings" class="mb-link">การจองทั้งหมด →</a>
            </section>

            <section class="mb-card" aria-labelledby="mb-rv-h">
                <h2 id="mb-rv-h">เล่าประสบการณ์ของคุณ</h2>
                @if (!Model.ToReview.Any()) { <p class="mb-muted">ไม่มีการเข้าพักที่รอรีวิว</p> }
                <ul class="mb-list">
                    @foreach (var b in Model.ToReview)
                    {
                        <li><span><b>@D(b.CheckIn)</b><span>#@b.BookingId</span></span><a asp-controller="Reviews" asp-action="Create" asp-route-id="@b.BookingId" class="cx-btn cx-btn--small">เขียนรีวิว</a></li>
                    }
                </ul>
                <p class="mb-muted">ยอดใช้จ่ายที่ชำระแล้วทั้งหมด @Model.Spent.ToString("N2") บาท</p>
            </section>

        </div>
        @if (Model.StayBookingId == null)
        {
            <section class="mb-hint" id="mb-req" aria-labelledby="mb-req-h0">
                <span class="mb-hint__ico" aria-hidden="true">🛎</span>
                <div>
                    <h2 id="mb-req-h0">ขอของใช้เพิ่ม / ขอทำความสะอาด</h2>
                    <p>เปิดให้ใช้หลังพนักงานเช็คอินให้แล้ว ขอผ้าเช็ดตัว น้ำดื่ม หมอน ส่งถึงห้อง สั่งบริการเสริม และขอทำความสะอาดได้จากหน้านี้ หรือโทรแจ้งเคาน์เตอร์ได้ตลอด 24 ชม.</p>
                </div>
            </section>
        }
      </div>

        <aside class="mb-side">
            @if (Model.MyCodes.Any())
            {
                <section class="mb-card mb-codes" aria-labelledby="mb-code-h">
                    <h2 id="mb-code-h">รหัสและคูปองของคุณ</h2>
                    <ul class="mb-codelist">
                        @foreach (var c in Model.MyCodes)
                        {
                            <li>
                                <div><code>@c.Code</code><b>ลด @c.Percent.ToString("0.##")%</b></div>
                                <p>@c.Name<small>@c.Condition</small></p>
                                <a asp-controller="Booking" asp-action="Create" asp-route-code="@c.Code" class="cx-btn cx-btn--small">จองพร้อมใช้รหัสนี้</a>
                            </li>
                        }
                    </ul>
                </section>
            }
            <section class="mb-card" aria-labelledby="mb-perk-h">
                <h2 id="mb-perk-h">สิทธิ์ส่วนลดของคุณ</h2>
                <p class="mb-muted"><a asp-controller="Promotions" asp-action="Index" asp-fragment="pm-claim">ดูคูปองเทศกาลที่เปิดให้เก็บ →</a></p>
                @if (!Model.Perks.Any()) { <p class="mb-muted">ยังไม่มีโปรโมชั่นที่เปิดอยู่ตอนนี้</p> }
                @{ var perkTop = Model.Perks.Take(4).ToList(); var perkRest = Model.Perks.Skip(4).ToList(); }
                <ul class="mb-perks">
                    @foreach (var p in perkTop)
                    {
                        <li class="@(p.Ready ? "" : "is-locked")" title="@(p.Hint ?? p.Condition)">
                            <b>@p.Percent.ToString("0.##")%</b>
                            <span><strong>@p.Name</strong><small>@(p.Hint ?? p.Condition)</small></span>
                        </li>
                    }
                </ul>
                @if (perkRest.Any())
                {
                    <details class="mb-more">
                        <summary>ดูสิทธิ์อื่นอีก @perkRest.Count รายการ</summary>
                        <ul class="mb-perks">
                            @foreach (var p in perkRest)
                            {
                                <li class="@(p.Ready ? "" : "is-locked")" title="@(p.Hint ?? p.Condition)">
                                    <b>@p.Percent.ToString("0.##")%</b>
                                    <span><strong>@p.Name</strong><small>@(p.Hint ?? p.Condition)</small></span>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (!Model.HasBirthDate || !Model.HasAnniversary)
                {
                    <a asp-controller="Settings" asp-action="Index" class="mb-link">เพิ่มวันเกิด / วันครบรอบ →</a>
                }
                <p class="mb-muted">ระบบเลือกส่วนลดที่คุ้มที่สุดให้อัตโนมัติ 1 รายการต่อการจอง</p>
                <a asp-controller="Promotions" asp-action="Index" class="mb-link">ดูรายละเอียดโปรโมชั่นทั้งหมด →</a>
            </section>
            <section class="mb-card" aria-labelledby="mb-nt-h">
                <h2 id="mb-nt-h">การแจ้งเตือน @if (Model.Unread > 0) { <span class="mb-pill">ใหม่ @Model.Unread</span> }</h2>
                @if (!Model.Notes.Any()) { <p class="mb-muted">ยังไม่มีการแจ้งเตือน</p> }
                <ul class="mb-list mb-notes">
                    @foreach (var x in Model.Notes)
                    {
                        <li class="@(x.Read ? "" : "is-new")"><span><b>@x.Title</b><span>@x.At.ToString("dd/MM/yyyy HH:mm")</span></span></li>
                    }
                </ul>
                <a data-no-instant asp-controller="Notifications" asp-action="Index" class="mb-link">ดูทั้งหมด →</a>
            </section>
        </aside>
    </div>

    @if (Model.StayBookingId is int stayId)
    {
        <section class="mb-card mb-req" id="mb-req" aria-labelledby="mb-req-h">
            <h2 id="mb-req-h">ขอของใช้เพิ่ม <span class="mb-pill">ฟรี ระหว่างเข้าพัก</span></h2>
            <form method="post" asp-controller="Member" asp-action="RequestItem" class="mb-req__form">
                <input type="hidden" name="bookingId" value="@stayId" />
                <label>รายการ
                    <select name="item" class="form-select" required>
                        @foreach (var (code, name) in RoomRequests.Items) { <option value="@code">@name</option> }
                    </select>
                </label>
                <label>ห้อง
                    <select name="roomId" class="form-select" required>
                        @foreach (var (rid, rno) in Model.StayRooms) { <option value="@rid">@rno</option> }
                    </select>
                </label>
                <label>จำนวน
                    <input type="number" name="qty" value="1" min="1" max="@RoomRequests.MaxQty" class="form-control" required />
                </label>
                <label class="mb-req__note">หมายเหตุ (ถ้ามี)
                    <input type="text" name="note" maxlength="200" class="form-control" placeholder="เช่น ขอหมอนนุ่ม, วางไว้หน้าห้อง" />
                </label>
                <label class="mb-req__urgent"><input type="checkbox" name="urgent" value="true" /> ด่วน</label>
                <button type="submit" class="cx-btn">ส่งคำขอ</button>
            </form>
            @if (Model.Requests.Any())
            {
                <ul class="mb-list mb-req__list">
                    @foreach (var r in Model.Requests)
                    {
                        <li>
                            <span><b>@r.What · ห้อง @r.RoomNo @if (r.Urgent) { <span class="mb-pill">ด่วน</span> }</b>
                                <span>ขอเมื่อ @r.CreatedAt.ToString("dd/MM HH:mm")@(r.DoneAt is { } d ? " · ส่งเมื่อ " + d.ToString("HH:mm") : "")@(r.Note != null ? " · " + r.Note : "")</span></span>
                            <span class="mb-wait__act">
                                <span class="cx-badge cx-badge--@r.Status">@RoomRequests.StatusLabel(r.Status, r.Missed)</span>
                                @if (r.Status == "PENDING")
                                {
                                    <form method="post" asp-controller="Member" asp-action="CancelRequest" asp-route-id="@r.Id" class="d-inline" onsubmit="return confirm('ยกเลิกคำขอนี้?')">
                                        <button type="submit" class="cx-btn cx-btn--ghost cx-btn--small">ยกเลิก</button>
                                    </form>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
            <p class="mb-muted">สถานะ: รอรับงาน → กำลังนำส่ง → ส่งแล้ว · เมื่อส่งถึงห้องจะมีการแจ้งเตือน</p>
        </section>
    }

    @if (Model.StayBookingId is int cleanStay)
    {
        <section class="mb-card mb-req" id="mb-svc" aria-labelledby="mb-svc-h">
            <h2 id="mb-svc-h">สั่งบริการเสริม <span class="mb-pill">ชำระตอนเช็คเอาท์</span></h2>
            @if (Model.StayServices.Any())
            {
                <form method="post" asp-controller="Member" asp-action="OrderService" class="mb-req__form">
                    <input type="hidden" name="bookingId" value="@Model.StayBookingId" />
                    <label>บริการ
                        <select name="serviceId" class="form-select" required>
                            @foreach (var sv in Model.StayServices) { <option value="@sv.Id">@sv.Name · @sv.Price.ToString("N0") บาท</option> }
                        </select>
                    </label>
                    <label>ห้อง
                        <select name="roomId" class="form-select" required>
                            @foreach (var (rid, rno) in Model.StayRooms) { <option value="@rid">@rno</option> }
                        </select>
                    </label>
                    <label>จำนวน
                        <input type="number" name="qty" value="1" min="1" max="@StayBill.MaxQty" class="form-control" required />
                    </label>
                    <label class="mb-req__urgent"><input type="checkbox" name="urgent" value="true" /> ด่วน</label>
                    <button type="submit" class="cx-btn">สั่ง</button>
                </form>
            }
            <h3 class="h6 mt-3">ค่าใช้จ่ายระหว่างพัก</h3>
            @if (!Model.StayLines.Any()) { <p class="mb-muted">ยังไม่มี (ค่ากิจกรรมที่จองไว้และบริการที่สั่งเพิ่มจะแสดงที่นี่)</p> }
            else
            {
                <ul class="mb-list mb-req__list">
                    @foreach (var l in Model.StayLines)
                    {
                        <li>
                            <span><b>@(l.Kind == "A" ? "กิจกรรม: " : "")@l.Title × @l.Qty@(l.RoomNo != null ? " · ห้อง " + l.RoomNo : "")</b>
                                <span>@l.Amount.ToString("N2") บาท@(l.Date is { } dd ? " · " + dd.ToString("dd/MM") : "")</span></span>
                            <span class="mb-wait__act">
                                <span class="cx-badge cx-badge--@(l.PaidAt != null ? "PAID" : "PENDING")">@(l.PaidAt != null ? "ชำระแล้ว" : "รอชำระ")</span>
                                @if (l.CanCancel)
                                {
                                    <form method="post" asp-controller="Member" asp-action="CancelService" asp-route-bsId="@l.Id" class="d-inline" onsubmit="return confirm('ยกเลิกรายการนี้?')">
                                        <button type="submit" class="cx-btn cx-btn--ghost cx-btn--small">ยกเลิก</button>
                                    </form>
                                }
                            </span>
                        </li>
                    }
                </ul>
                <p class="mb-muted"><b>ยอดที่ต้องชำระที่เคาน์เตอร์ตอนเช็คเอาท์: @Model.StayLines.Where(l => l.PaidAt == null).Sum(l => l.Amount).ToString("N2") บาท</b> (เงินสด / โอน / บัตร)</p>
                @if (Model.StayLines.Any(l => l.PaidAt != null)) { <a href="/Booking/StayReceipt/@Model.StayBookingId" class="mb-link">ใบเสร็จรายการที่ชำระแล้ว →</a> }
            }
        </section>

        <section class="mb-card mb-req" id="mb-clean" aria-labelledby="mb-clean-h">
            <h2 id="mb-clean-h">ทำความสะอาดห้อง @if (Model.DoNotDisturb) { <span class="mb-pill">ห้ามรบกวน</span> }</h2>
            <div class="mb-clean__dnd">
                <span>@(Model.DoNotDisturb ? "ตอนนี้ติดป้าย \"ห้ามรบกวน\" อยู่ แม่บ้านจะไม่เข้าห้อง" : "ต้องการความเป็นส่วนตัว ติดป้าย \"ห้ามรบกวน\" ได้")</span>
                <form method="post" asp-controller="Member" asp-action="DoNotDisturb" class="d-inline">
                    <input type="hidden" name="bookingId" value="@cleanStay" /><input type="hidden" name="on" value="@(Model.DoNotDisturb ? "false" : "true")" />
                    <button type="submit" class="cx-btn cx-btn--ghost cx-btn--small">@(Model.DoNotDisturb ? "ปลดป้ายห้ามรบกวน" : "ติดป้ายห้ามรบกวน")</button>
                </form>
            </div>
            <form method="post" asp-controller="Member" asp-action="RequestCleaning" class="mb-req__form">
                <input type="hidden" name="bookingId" value="@cleanStay" />
                <label>ห้อง
                    <select name="roomId" class="form-select" required>
                        @foreach (var (rid, rno) in Model.StayRooms) { <option value="@rid">@rno</option> }
                    </select>
                </label>
                <label>ช่วงเวลาที่สะดวก
                    <select name="slot" class="form-select" required>
                        @foreach (var sl in HousekeepingOps.Slots) { <option value="@sl">@sl</option> }
                    </select>
                </label>
                <label class="mb-req__note">หมายเหตุ (ถ้ามี)
                    <input type="text" name="note" maxlength="200" class="form-control" placeholder="เช่น เปลี่ยนผ้าปูที่นอน, ไม่ต้องเปลี่ยนผ้าเช็ดตัว" />
                </label>
                <button type="submit" class="cx-btn">ขอทำความสะอาด</button>
            </form>
            @if (Model.Cleanings.Any())
            {
                <ul class="mb-list mb-req__list">
                    @foreach (var c in Model.Cleanings)
                    {
                        <li>
                            <span><b>@c.What · ห้อง @c.RoomNo</b>
                                <span>ขอเมื่อ @c.CreatedAt.ToString("dd/MM HH:mm")@(c.Note != null ? " · สะดวก " + c.Note : "")@(c.DoneAt is { } cd ? " · เสร็จเมื่อ " + cd.ToString("HH:mm") : "")</span></span>
                            <span class="cx-badge cx-badge--@c.Status">@HousekeepingOps.StatusLabel(c.Status, c.Missed)</span>
                        </li>
                    }
                </ul>
            }
            <p class="mb-muted">สถานะ: รอรับงาน → กำลังทำ → เสร็จแล้ว · ทำเสร็จจะมีการแจ้งเตือน</p>
        </section>
    }

    @if (Model.Waiting.Any())
    {
        <section class="mb-card mb-wait" aria-labelledby="mb-wait-h">
            <h2 id="mb-wait-h">รอห้องว่าง</h2>
            <ul class="mb-list">
                @foreach (var w in Model.Waiting)
                {
                    <li>
                        <span><b>@w.What</b><span>@D(w.CheckIn) – @D(w.CheckOut) · @w.Guests คน</span></span>
                        @if (w.Status == "NOTIFIED")
                        {
                            <a class="cx-btn cx-btn--small" href="/Booking/Create?checkIn=@w.CheckIn.ToString("yyyy-MM-dd")&checkOut=@w.CheckOut.ToString("yyyy-MM-dd")&guests=@w.Guests">มีห้องว่างแล้ว — จองเลย</a>
                        }
                        else
                        {
                            <span class="mb-wait__act">
                                <span class="cx-badge cx-badge--PENDING">กำลังรอ</span>
                                <form method="post" asp-controller="Member" asp-action="CancelWait" asp-route-id="@w.WaitId" class="d-inline" onsubmit="return confirm('ยกเลิกการรอห้องว่างรายการนี้?')">
                                    <button type="submit" class="cx-btn cx-btn--ghost cx-btn--small">ยกเลิก</button>
                                </form>
                            </span>
                        }
                    </li>
                }
            </ul>
            <p class="mb-muted">ระบบตรวจทุก 10 นาที และแจ้งเตือนทันทีเมื่อมีห้องว่างครบช่วงที่ต้องการ (ในเว็บและทางอีเมล)</p>
        </section>
    }
</div>
