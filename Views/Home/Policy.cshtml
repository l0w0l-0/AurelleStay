@model pameka_7033_l005.Helpers.HotelInfo
@using pameka_7033_l005.Helpers
@{
    ViewData["Title"] = "เงื่อนไขการจองและนโยบายความเป็นส่วนตัว";
    ViewData["Description"] = $"เงื่อนไขการจอง การชำระเงิน การยกเลิก การคืนเงิน และนโยบายความเป็นส่วนตัวของ {Model.Name}";
    Layout = "_Homelayout";
    var contact = Model.HasContact ? "ตามช่องทางในหน้าติดต่อเรา" : "ที่เคาน์เตอร์ต้อนรับ";
}

<div class="cx-wrap cx-page cx-policy">
    <h1>เงื่อนไขการจองและนโยบายความเป็นส่วนตัว</h1>
    <nav class="cx-toc" aria-label="สารบัญ">
        <a href="#booking">การจองและชำระเงิน</a>
        <a href="#cancel">การยกเลิกและคืนเงิน</a>
        <a href="#stay">การเข้าพัก</a>
        <a href="#privacy">ความเป็นส่วนตัว</a>
    </nav>

    <section class="cx-box" id="booking">
        <h2>1. การจองและการชำระเงิน</h2>
        <ul>
            <li>จองได้ครั้งละไม่เกิน @BookingRules.MaxRooms ห้อง ไม่เกิน @BookingRules.MaxNights คืน และล่วงหน้าได้ไม่เกิน @BookingRules.MaxAdvanceDays วัน</li>
            <li>ราคาที่แสดงเป็นราคาต่อห้องต่อคืน ระบบคำนวณยอดรวมจากจำนวนคืน จำนวนห้อง และบริการเสริมที่เลือก</li>
            <li>ส่วนลดโปรโมชั่นใช้ได้ 1 รายการต่อการจอง ระบบเลือกรายการที่ให้ส่วนลดสูงสุดให้อัตโนมัติ</li>
            <li>ชำระเงินด้วยการสแกน QR แล้วแนบหลักฐานการโอน (สลิป) ฝ่ายบัญชีจะตรวจสอบก่อนยืนยันการจอง
                สถานะ "ชำระแล้ว" จะแสดงหลังฝ่ายบัญชียืนยันเท่านั้น</li>
            <li>ต้องแนบหลักฐานภายใน @Model.PaymentHoldHours ชั่วโมงหลังจอง (และไม่เกินวันเข้าพัก) มิฉะนั้นระบบจะยกเลิกการจองอัตโนมัติเพื่อคืนห้องให้ผู้อื่น</li>
            <li>หากหลักฐานไม่ผ่านการตรวจสอบ สามารถแนบใหม่ได้ภายใน @Model.PaymentHoldHours ชั่วโมงนับจากเวลาที่แจ้งผล</li>
            <li>การจองผ่านเคาน์เตอร์ชำระเป็นเงินสดและยืนยันทันที</li>
        </ul>
    </section>

    <section class="cx-box" id="cancel">
        <h2>2. การยกเลิกและการคืนเงิน</h2>
        <ul>
            <li>การจองที่ยังไม่ได้ชำระเงิน ยกเลิกเองได้ที่เมนู "การจองของฉัน"</li>
            <li>การจองที่ชำระแล้วและยังไม่เช็คอิน กด "ขอคืนเงิน" ได้ก่อนวันสิ้นสุดการเข้าพัก ระบบส่งคำขอคืนเงินเต็มจำนวนที่ชำระไปให้ฝ่ายบัญชีพิจารณา การจองจะถูกยกเลิกเมื่อฝ่ายบัญชีอนุมัติ</li>
            <li>ระหว่างรอตรวจสอบหลักฐานการชำระเงิน ยกเลิกเองไม่ได้ กรุณาติดต่อโรงแรม@(contact)</li>
            <li>หลังเช็คอินแล้วไม่สามารถยกเลิกหรือขอคืนเงินผ่านระบบได้</li>
        </ul>
    </section>

    <section class="cx-box" id="stay">
        <h2>3. การเข้าพัก</h2>
        <ul>
            <li>เช็คอินได้ตั้งแต่เวลา @Model.CheckInTime น. และเช็คเอาท์ไม่เกินเวลา @Model.CheckOutTime น.</li>
            <li>กรุณาแสดงเลขที่การจองหรืออีเมลที่ใช้จองกับเจ้าหน้าที่ตอนเช็คอิน</li>
            <li>จำนวนผู้เข้าพักต้องไม่เกินจำนวนที่ห้องรองรับ ระบบตรวจสอบให้ตั้งแต่ตอนจอง</li>
        </ul>
    </section>

    <section class="cx-box" id="privacy">
        <h2>4. นโยบายความเป็นส่วนตัว</h2>
        <p>@Model.Name เก็บและใช้ข้อมูลส่วนบุคคลเท่าที่จำเป็นต่อการให้บริการที่พัก ตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562</p>
        <h3>ข้อมูลที่เก็บ</h3>
        <ul>
            <li>ข้อมูลบัญชี: ชื่อ นามสกุล เบอร์โทร อีเมล และวันเกิด/วันครบรอบ (เฉพาะเมื่อคุณกรอกเพื่อรับส่วนลด)</li>
            <li>ข้อมูลการจอง การชำระเงิน หลักฐานการโอน และรีวิวที่คุณเขียน</li>
            <li>ประวัติการเข้าสู่ระบบ (อีเมลและเวลา) เพื่อความปลอดภัยของบัญชี</li>
        </ul>
        <h3>วัตถุประสงค์และผู้เข้าถึงข้อมูล</h3>
        <ul>
            <li>ใช้เพื่อจองห้อง ตรวจสอบการชำระเงิน ดูแลการเข้าพัก ให้ส่วนลดสมาชิก และติดต่อเรื่องการจองของคุณเท่านั้น</li>
            <li>พนักงานเห็นข้อมูลเฉพาะที่จำเป็นต่อหน้าที่ เช่น ฝ่ายบัญชีเห็นหลักฐานการโอน ฝ่ายบริการเห็นข้อมูลการเข้าพัก</li>
            <li>ไม่ขายหรือเปิดเผยข้อมูลให้บุคคลภายนอก เว้นแต่กฎหมายกำหนด</li>
        </ul>
        <h3>การรักษาความปลอดภัย</h3>
        <ul>
            <li>รหัสผ่านถูกเก็บแบบเข้ารหัสทางเดียว เจ้าหน้าที่ไม่สามารถดูรหัสผ่านของคุณได้</li>
            <li>หลักฐานการโอนเก็บในพื้นที่ที่ไม่เปิดสาธารณะ ดูได้เฉพาะเจ้าของการจองและเจ้าหน้าที่ที่เกี่ยวข้อง</li>
        </ul>
        <h3>คุกกี้</h3>
        <p>เว็บไซต์ใช้เฉพาะคุกกี้ที่จำเป็นต่อการทำงาน ได้แก่ คุกกี้เข้าสู่ระบบ คุกกี้ป้องกันการปลอมแปลงคำขอ และคุกกี้จำการตั้งค่าการแสดงผล ไม่มีคุกกี้โฆษณาหรือติดตามพฤติกรรม</p>
        <h3>สิทธิของคุณ</h3>
        <ul>
            <li>ดูและแก้ไขข้อมูลบัญชีได้ที่หน้า "ตั้งค่า"</li>
            <li>ดาวน์โหลดสำเนาข้อมูลของคุณ และลบบัญชีได้ที่หน้า "ตั้งค่า" หัวข้อ "ข้อมูลของฉัน" (บัญชีที่มีประวัติการจองต้องเก็บข้อมูลการจองไว้ตามหลักฐานทางบัญชี)</li>
            <li>สอบถามหรือขอใช้สิทธิอื่นตามกฎหมาย ติดต่อโรงแรม@(contact)</li>
        </ul>
    </section>

    @if (Model.HasContact)
    {
        <p><a href="@Url.Action("About", "Home")#contact" class="cx-btn cx-btn--ghost">ติดต่อเรา</a></p>
    }
</div>
