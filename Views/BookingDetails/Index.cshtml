@model pameka_7033_l005.ViewModels.BookingDetailViewModel
@using pameka_7033_l005.Helpers
@{
    ViewData["Title"] = $"การจอง #{Model.BookingId}";
    var isCustomer = User.IsInRole(RoleNames.Customer);
    var isAdmin = User.IsInRole(RoleNames.Admin);
    Layout = isCustomer ? "_Homelayout" : "_Adminlayout";
    var (backCtl, backAct, backLabel) = isCustomer ? ("Booking", "MyBookings", "การจองของฉัน")
        : isAdmin ? ("AdminBookings", "Index", "รายการการจอง")
        : User.IsInRole(RoleNames.FrontDesk) ? ("FrontDesk", "Index", "เช็คอิน / เช็คเอาท์")
        : ("Accounting", "Index", "ตรวจสอบการชำระเงิน");
}

<div class="cx-wrap cx-page cx-receipt">
    <p class="cx-noprint"><a asp-controller="@backCtl" asp-action="@backAct">« กลับ@(backLabel)</a></p>
    <h1>การจอง #@Model.BookingId <span class="cx-badge cx-badge--@Model.Status">@ThaiLabels.BookingStatus(Model.Status)</span></h1>
    <partial name="_Flash" />

    <section class="cx-box">
        <dl class="cx-dl">
            <dt>ผู้จอง</dt><dd>@Model.Customer · @Model.Email · @Model.Phone</dd>
            <dt>เข้าพัก</dt><dd>@Model.CheckIn.ToString("dd/MM/yyyy") ถึง @Model.CheckOut.ToString("dd/MM/yyyy") (@(Model.CheckOut.DayNumber - Model.CheckIn.DayNumber) คืน)</dd>
            <dt>จองเมื่อ</dt><dd>@Model.BookedAt.ToString("dd/MM/yyyy HH:mm")</dd>
            @if (Model.Guests.HasValue) { <dt>ผู้เข้าพัก</dt><dd>@Model.Guests คน</dd> }
            @if (BookingWorkflow.CanPay(Model.Status, Model.Flags))
            {
                <dt>ชำระภายใน</dt><dd class="cx-paydue">@BookingExpiry.Deadline(Model.BookedAt, Model.CheckIn, Model.LastRejectedAt).ToString("dd/MM/yyyy HH:mm") น. (เกินกำหนดระบบยกเลิกอัตโนมัติ)</dd>
            }
            <dt>โปรโมชั่น</dt><dd>@(Model.PromoName ?? "ไม่ได้ใช้")</dd>
            @if (!isCustomer) { <dt>ยืนยันโดย</dt><dd>@(Model.ConfirmedBy ?? "–")</dd> }
            @if (Model.ArrivalTime != null) { <dt>เวลาที่จะมาถึง</dt><dd>ประมาณ @Model.ArrivalTime น.</dd> }
            @if (Model.GuestRequest != null) { <dt>คำขอพิเศษ</dt><dd class="bd-request">@Model.GuestRequest</dd> }
        </dl>
    </section>

    @if (Model.CanPreArrival && !User.IsInRole(RoleNames.Accounting))
    {
        @* Part 50: เช็คอินออนไลน์ล่วงหน้า — ช่วยฝ่ายบริการเตรียมห้อง ลดเวลาที่เคาน์เตอร์ *@
        var slots = Enumerable.Range(0, 24 * 2).Select(i => $"{i / 2:00}:{(i % 2) * 30:00}").Where(t => string.CompareOrdinal(t, "06:00") >= 0).ToList();
        if (Model.ArrivalTime != null && !slots.Contains(Model.ArrivalTime)) slots.Add(Model.ArrivalTime);
        <details class="cx-box bd-pre cx-noprint" @(Model.ArrivalTime == null && Model.GuestRequest == null ? "open" : "")>
            <summary><h2>เช็คอินออนไลน์ล่วงหน้า</h2><span>@(Model.ArrivalTime != null || Model.GuestRequest != null ? "แจ้งแล้ว · แก้ไขได้" : "แจ้งเวลาที่จะมาถึงและคำขอพิเศษ ช่วยให้เช็คอินเร็วขึ้น")</span></summary>
            <form method="post" action="/Booking/PreArrival/@Model.BookingId" class="bd-pre__form">
                @Html.AntiForgeryToken()
                <label class="cx-field">เวลาที่จะมาถึง (โดยประมาณ)
                    <select name="arrivalTime">
                        <option value="">ยังไม่แน่ใจ</option>
                        @foreach (var s in slots) { <option value="@s" selected="@(s == Model.ArrivalTime)">@s น.@(s == "14:00" ? " (เวลาเช็คอิน)" : "")</option> }
                    </select>
                </label>
                <label class="cx-field bd-pre__wide">คำขอพิเศษ (ถ้ามี)
                    <textarea name="request" maxlength="300" rows="3" placeholder="เช่น ขอห้องชั้นสูง หมอนเพิ่ม เตียงเด็ก มาถึงดึก ฉลองวันเกิด">@Model.GuestRequest</textarea>
                    <small class="cx-hint">โรงแรมจะพยายามจัดให้ตามความพร้อม</small>
                </label>
                <div class="bd-pre__act"><button type="submit" class="cx-btn">บันทึกข้อมูลเช็คอิน</button></div>
            </form>
        </details>
    }

    <section class="cx-box">
        <h2>ห้องพัก</h2>
        <div class="table-responsive" tabindex="0" role="region" aria-label="ตารางห้องพัก"><table class="table">
            <thead><tr><th>ห้อง</th><th>ประเภท</th><th class="text-end">ราคา/คืน</th><th class="text-end">คืน</th><th class="text-end">รวม (บาท)</th></tr></thead>
            <tbody>@foreach (var r in Model.Rooms) { <tr><td>@r.RoomNo</td><td>@r.Type</td><td class="text-end">@r.Price.ToString("N2")</td><td class="text-end">@r.Nights</td><td class="text-end">@((r.Price * r.Nights).ToString("N2"))</td></tr> }</tbody>
        </table></div>

        @if (Model.Services.Any())
        {
            <h2>บริการเสริม</h2>
            <div class="table-responsive" tabindex="0" role="region" aria-label="ตารางบริการเสริม"><table class="table">
                <thead><tr><th>ห้อง</th><th>บริการ</th><th class="text-end">ราคา/หน่วย</th><th class="text-end">จำนวน</th><th class="text-end">รวม (บาท)</th></tr></thead>
                <tbody>@foreach (var s in Model.Services) { <tr><td>@s.RoomNo</td><td>@s.Service</td><td class="text-end">@s.Unit.ToString("N2")</td><td class="text-end">@s.Qty</td><td class="text-end">@((s.Unit * s.Qty).ToString("N2"))</td></tr> }</tbody>
            </table></div>
        }

        <dl class="cx-dl cx-totals">
            <dt>ยอดรวม</dt><dd>@Model.Subtotal.ToString("N2") บาท</dd>
            <dt>ส่วนลด</dt><dd>− @Model.Discount.ToString("N2") บาท</dd>
            <dt>ยอดสุทธิ</dt><dd><b>@Model.Net.ToString("N2") บาท</b></dd>
        </dl>

        @if (Model.StayLines.Any())
        {
            <h2>ค่าใช้จ่ายระหว่างพัก <small class="text-muted">(แยกจากยอดจอง ชำระที่เคาน์เตอร์ก่อนเช็คเอาท์)</small></h2>
            <div class="table-responsive" tabindex="0" role="region" aria-label="ตารางค่าใช้จ่ายระหว่างพัก"><table class="table">
                <thead><tr><th>รายการ</th><th class="text-end">จำนวน</th><th class="text-end">ยอด (บาท)</th><th>สถานะ</th></tr></thead>
                <tbody>@foreach (var l in Model.StayLines) { <tr><td>@(l.Kind == "A" ? "กิจกรรม: " : "บริการ: ")@l.Title@(l.RoomNo != null ? " · ห้อง " + l.RoomNo : "")</td><td class="text-end">@l.Qty</td><td class="text-end">@l.Amount.ToString("N2")</td><td>@(l.PaidAt != null ? $"ชำระแล้ว ({pameka_7033_l005.Helpers.StayBill.MethodName(l.Method)})" : "รอชำระ")</td></tr> }</tbody>
                <tfoot><tr><th colspan="2" class="text-end">ค้างชำระ</th><th class="text-end">@Model.StayLines.Where(l => l.PaidAt == null).Sum(l => l.Amount).ToString("N2")</th><th></th></tr></tfoot>
            </table></div>
        }
    </section>

    <section class="cx-box">
        <h2>การชำระเงิน</h2>
        @if (!Model.Payments.Any()) { <p>ยังไม่มีรายการชำระเงิน</p> }
        else
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="ตารางการชำระเงิน"><table class="table">
                <thead><tr><th>รายการ</th><th>วิธี</th><th>สถานะ</th><th class="text-end">จำนวน (บาท)</th><th>เวลา</th><th>หลักฐาน</th>@if (!isCustomer) { <th>ดำเนินการโดย</th> }</tr></thead>
                <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr><td>@(p.Type == BookingWorkflow.RefundType ? "คืนเงิน" : "ชำระเงิน")</td><td>@ThaiLabels.PaymentMethod(p.Method)</td><td>@ThaiLabels.PaymentStatus(p.Type, p.Status)</td><td class="text-end">@p.Amount.ToString("N2")</td><td>@p.PaidAt?.ToString("dd/MM/yyyy HH:mm")</td><td>@if (p.HasSlip) { <a href="/Booking/Slip/@p.Id" target="_blank" rel="noopener">ดูสลิป</a> } @if (!string.IsNullOrEmpty(p.Reference)) { <small>อ้างอิง @p.Reference</small> }</td>@if (!isCustomer) { <td>@p.By</td> }</tr>
                }
                </tbody>
            </table></div>
        }
    </section>

    @if (!isCustomer && Model.Tasks.Any())
    {
        <section class="cx-box">
            <h2>งานส่งของ / ทำความสะอาด</h2>
            <div class="table-responsive" tabindex="0" role="region" aria-label="ตารางงานส่งของ / ทำความสะอาด"><table class="table">
                <thead><tr><th>งาน</th><th>ห้อง</th><th>สถานะ</th><th>ผู้รับงาน</th><th>เสร็จเมื่อ</th></tr></thead>
                <tbody>@foreach (var t in Model.Tasks) { <tr><td>@t.Kind</td><td>@t.RoomNo</td><td>@ThaiLabels.TaskStatus(t.Status)</td><td>@t.Who</td><td>@t.DoneAt?.ToString("dd/MM/yyyy HH:mm")</td></tr> }</tbody>
            </table></div>
        </section>
    }

    @if (Model.Review != null)
    {
        <section class="cx-box">
            <h2>รีวิว</h2>
            <p>@ThaiLabels.Stars(Model.Review.Value.Rating) · @Model.Review.Value.At.ToString("dd/MM/yyyy")</p>
            <p>@Model.Review.Value.Comment</p>
        </section>
    }

    <div class="cx-actions cx-noprint">
        @if (isCustomer)
        {
            @if (BookingWorkflow.CanPay(Model.Status, Model.Flags))
            {
                <a asp-controller="Booking" asp-action="Pay" asp-route-id="@Model.BookingId" class="cx-btn">ชำระเงิน</a>
            }
            @if (Model.Status is "CHECKED_OUT" or "CANCELLED" or "NO_SHOW" && Model.RoomIds.Any())
            {
                <a href="@(Url.Action("Create", "Booking") + "?" + string.Join("&", Model.RoomIds.Select(i => "roomIds=" + i)))" class="cx-btn">จองห้องเดิมอีกครั้ง</a>
            }
            @if (BookingWorkflow.CanReview(Model.Status, Model.Reviewed))
            {
                <a asp-controller="Reviews" asp-action="Create" asp-route-id="@Model.BookingId" class="cx-btn">เขียนรีวิว</a>
            }
            @if (BookingWorkflow.CanCancelDirect(Model.Status, Model.Flags))
            {
                <form asp-controller="Booking" asp-action="Cancel" method="post" onsubmit="return confirm('ยืนยันยกเลิกการจองนี้ ?');">
                    <input type="hidden" name="id" value="@Model.BookingId" />
                    <button type="submit" class="cx-btn cx-btn--danger">ยกเลิกการจอง</button>
                </form>
            }
            @if (BookingWorkflow.CanCustomerRequestRefund(Model.Status, Model.Flags, Model.CheckOut, DateOnly.FromDateTime(pameka_7033_l005.Helpers.AppClock.Today)))
            {
                <form asp-controller="Booking" asp-action="RequestRefund" method="post" onsubmit="return confirm('ขอยกเลิกและคืนเงินการจองนี้ ?');">
                    <input type="hidden" name="id" value="@Model.BookingId" />
                    <button type="submit" class="cx-btn cx-btn--danger">ขอยกเลิกและคืนเงิน</button>
                </form>
            }
        }
        else if (isAdmin && (Model.Status == "PENDING" || BookingWorkflow.CanRequestRefund(Model.Status, Model.Flags)))
        {
            <form asp-controller="AdminBookings" asp-action="Cancel" method="post"
                  data-msg="@(Model.Status == "PENDING" ? "ยกเลิกการจองนี้ ?" : "สร้างคำขอคืนเงินเต็มจำนวนให้ฝ่ายบัญชีอนุมัติ ?")" onsubmit="return confirm(this.dataset.msg);">
                <input type="hidden" name="id" value="@Model.BookingId" />
                <button type="submit" class="cx-btn cx-btn--danger">@(Model.Status == "PENDING" ? "ยกเลิกการจอง" : Model.Status == "NO_SHOW" ? "คืนเงินกรณีพิเศษ (ให้ฝ่ายบัญชีอนุมัติ)" : "ยกเลิกและขอคืนเงิน (ให้ฝ่ายบัญชีอนุมัติ)")</button>
            </form>
        }
        <a href="/Booking/Document/@Model.BookingId?kind=confirmation" class="cx-btn cx-btn--ghost">ใบยืนยันการจอง (PDF)</a>
        @if (Model.Status is "PENDING" or "CONFIRMED" or "CHECKED_IN")
        {
            var gcal = "https://calendar.google.com/calendar/render?action=TEMPLATE"
                + "&text=" + Uri.EscapeDataString($"เข้าพัก AurelleStay · การจอง #{Model.BookingId}")
                + "&dates=" + Model.CheckIn.ToString("yyyyMMdd") + "/" + Model.CheckOut.ToString("yyyyMMdd")
                + "&details=" + Uri.EscapeDataString("ห้อง " + string.Join(", ", Model.Rooms.Select(r => r.RoomNo + " " + r.Type)));
            <a href="/Booking/Calendar/@Model.BookingId" class="cx-btn cx-btn--ghost" download>เพิ่มลงปฏิทิน (.ics)</a>
            <a href="@gcal" class="cx-btn cx-btn--ghost" target="_blank" rel="noopener">Google Calendar</a>
        }
        @if (Model.Payments.Any(p => p.Type == BookingWorkflow.PaymentType && p.Status is "PAID" or "REFUNDED"))
        {
            <a href="/Booking/Document/@Model.BookingId?kind=receipt" class="cx-btn cx-btn--ghost">ใบเสร็จรับเงิน (PDF)</a>
        }
    </div>
</div>
