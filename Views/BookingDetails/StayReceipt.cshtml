@model pameka_7033_l005.ViewModels.BookingDetailViewModel
@using pameka_7033_l005.Helpers
@{
    Layout = null;
    var hotel = (HotelInfo)ViewData["Hotel"]!;
    var paid = Model.StayLines.Where(l => l.PaidAt != null).OrderBy(l => l.PaidAt).ToList();
    var last = paid.Max(l => l.PaidAt)!.Value;
    var docNo = $"RX-{last:yyyyMMdd}-{Model.BookingId:000000}";
    var due = Model.StayLines.Where(l => l.PaidAt == null).Sum(l => l.Amount);
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>ใบเสร็จค่าใช้จ่ายระหว่างพัก @docNo - @hotel.Name</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/document.css" asp-append-version="true" />
</head>
<body>
    <nav class="doc-bar" aria-label="เครื่องมือเอกสาร">
        <a href="/Booking/Details/@Model.BookingId" class="doc-link">« กลับรายละเอียดการจอง</a>
        <button type="button" class="doc-print" onclick="window.print()">พิมพ์ / บันทึกเป็น PDF</button>
    </nav>
    <main class="doc-sheet">
        <header class="doc-head">
            <div class="doc-brand">
                <p class="doc-logo">Aurelle<em>Stay</em></p>
                <p class="doc-hotel">@hotel.Name</p>
            </div>
            <div class="doc-title">
                <p class="doc-en">Incidental Charges Receipt</p>
                <h1>ใบเสร็จค่าใช้จ่ายระหว่างพัก</h1>
                <dl>
                    <dt>เลขที่</dt><dd>@docNo</dd>
                    <dt>วันที่</dt><dd>@last.ToString("dd/MM/yyyy")</dd>
                    <dt>การจอง</dt><dd>#@Model.BookingId</dd>
                </dl>
            </div>
        </header>
        <section class="doc-parties">
            <div><h2>ได้รับเงินจาก</h2><p><b>@Model.Customer</b><br />@Model.Email<br />@Model.Phone</p></div>
            <div><h2>การเข้าพัก</h2><p>ห้อง @string.Join(", ", Model.Rooms.Select(r => r.RoomNo))<br />@Model.CheckIn.ToString("dd/MM/yyyy") – @Model.CheckOut.ToString("dd/MM/yyyy")</p></div>
        </section>
        <table class="doc-items">
            <thead><tr><th>รายการ</th><th class="num">จำนวน</th><th class="num">วิธีชำระ</th><th class="num">จำนวนเงิน (บาท)</th></tr></thead>
            <tbody>
                @foreach (var l in paid)
                {
                    <tr><td>@(l.Kind == "A" ? "กิจกรรม: " : "บริการ: ")@l.Title@(l.RoomNo != null ? $" (ห้อง {l.RoomNo})" : "")@(l.Date is { } d ? $" · {d:dd/MM/yyyy}" : "")</td>
                        <td class="num">@l.Qty@(l.Kind == "A" ? " คน" : "")</td><td class="num">@StayBill.MethodName(l.Method)</td><td class="num">@l.Amount.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
        <div class="doc-bottom">
            <div class="doc-pay">
                <h2>หมายเหตุ</h2>
                <dl><dt>ค่าห้องพัก</dt><dd>ชำระแล้วตามใบเสร็จการจอง (แยกฉบับ)</dd>
                    @if (due > 0) { <dt>ยังค้างชำระ</dt><dd>@due.ToString("N2") บาท</dd> }</dl>
            </div>
            <dl class="doc-total">
                <dt class="grand">รับเงินสุทธิ</dt><dd class="grand">@paid.Sum(l => l.Amount).ToString("N2") <small>บาท</small></dd>
            </dl>
        </div>
        <footer class="doc-foot">
            <p>ขอบคุณที่เลือกพักกับ @hotel.Name</p>
            <small>เอกสารออกจากระบบโดยอัตโนมัติ เมื่อ @AppClock.Now.ToString("dd/MM/yyyy HH:mm") น. · ใบเสร็จนี้ไม่ใช่ใบกำกับภาษี</small>
        </footer>
    </main>
</body>
</html>
