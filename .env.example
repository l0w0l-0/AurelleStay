# คัดลอกไฟล์นี้เป็น .env แล้วเปลี่ยนรหัสผ่าน (.\docker.ps1 up สร้างให้อัตโนมัติพร้อมรหัสสุ่ม)
# ไฟล์ .env มีรหัสผ่านจริง ห้ามส่งให้คนอื่นและห้ามใส่ใน ZIP
DB_ROOT_PASSWORD=CHANGE_ME_root
DB_PASSWORD=CHANGE_ME_app
WEB_PORT=8088
DB_HOST_PORT=3317
HOTEL_NAME=AurelleStay
HOTEL_PHONE=
HOTEL_EMAIL=
HOTEL_LINE=
HOTEL_ADDRESS=
# ช่องทางรับเงิน: เบอร์พร้อมเพย์ (10 หลัก) หรือเลขบัตรประชาชน/นิติบุคคล (13 หลัก) → หน้าชำระเงินสร้าง QR ระบุยอดให้อัตโนมัติ
PROMPTPAY_ID=
PAY_ACCOUNT_NAME=
PAY_BANK_NAME=
PAY_ACCOUNT_NO=
# true เมื่อเปิดเว็บผ่าน https (reverse proxy) · false เมื่อเปิดผ่าน http ธรรมดา
HTTPS_ONLY_COOKIES=false
# ผู้จัดการคนแรก (ระบบสร้างให้ตอนเปิดครั้งแรกถ้ายังไม่มีผู้จัดการ) — รหัสผ่าน ≥ 8 ตัว มีตัวอักษรและตัวเลข
ADMIN_EMAIL=admin@aurellestay.local
ADMIN_PASSWORD=CHANGE_ME_admin1
