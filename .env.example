# คัดลอกไฟล์นี้เป็น .env แล้วเปลี่ยนรหัสผ่าน (.\docker.ps1 up สร้างให้อัตโนมัติพร้อมรหัสสุ่ม)
# ไฟล์ .env มีรหัสผ่านจริง ห้ามส่งให้คนอื่นและห้ามใส่ใน ZIP
DB_ROOT_PASSWORD=CHANGE_ME_root
DB_PASSWORD=CHANGE_ME_app
WEB_PORT=8088
DB_HOST_PORT=3317
HOTEL_NAME=AurelleStay
HOTEL_PHONE=
HOTEL_EMAIL=
HOTEL_LINE=
HOTEL_ADDRESS=
# ช่องทางรับเงิน: เบอร์พร้อมเพย์ (10 หลัก) หรือเลขบัตรประชาชน/นิติบุคคล (13 หลัก) → หน้าชำระเงินสร้าง QR ระบุยอดให้อัตโนมัติ
PROMPTPAY_ID=
PAY_ACCOUNT_NAME=
PAY_BANK_NAME=
PAY_ACCOUNT_NO=
# true เมื่อเปิดเว็บผ่าน https (reverse proxy) · false เมื่อเปิดผ่าน http ธรรมดา
HTTPS_ONLY_COOKIES=false
# ผู้จัดการคนแรก (ระบบสร้างให้ตอนเปิดครั้งแรกถ้ายังไม่มีผู้จัดการ) — รหัสผ่าน ≥ 8 ตัว มีตัวอักษรและตัวเลข
ADMIN_EMAIL=admin@aurellestay.local
ADMIN_PASSWORD=CHANGE_ME_admin1
# ---- อีเมล (ไม่บังคับ) — ว่าง = ปิด ระบบยังใช้ได้ครบ ----
# Gmail: เปิด 2-Step Verification แล้วสร้าง App Password ที่ https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
# ที่อยู่เว็บที่ใส่ในลิงก์ของอีเมล (เปลี่ยนเป็น IP เครื่อง/โดเมน ถ้าเปิดจากเครื่องอื่น)
PUBLIC_URL=http://localhost:8088
# ---- บริการภายนอก (ไม่บังคับ) — ว่าง = ปิด ----
# SlipOK ตรวจสลิปอัตโนมัติ: สมัครที่ slipok.com → สร้างสาขา API ได้ Branch ID + API Key (ตั้งบัญชีรับเงินของโรงแรมในสาขานั้น)
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
# true = ตรวจผ่านครบแล้วยืนยันการจองเอง · false = แค่บันทึกผลตรวจให้ฝ่ายบัญชีดู
SLIPOK_AUTO_APPROVE=true
# Opn Payments (Omise) QR พร้อมเพย์ยืนยันอัตโนมัติ: Dashboard → Keys → Secret key (ทดสอบใช้ skey_test_...)
# Webhook (ถ้ามีโดเมน https): https://โดเมนของคุณ/webhooks/omise
OMISE_SECRET_KEY=
# LINE แจ้งเตือนพนักงาน: LINE Developers → Messaging API channel → Channel access token (long-lived)
# LINE_TO = userId / groupId ที่จะรับแจ้งเตือน (ต้องเพิ่มบอทเป็นเพื่อนหรือเชิญเข้ากลุ่มก่อน)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# แผนที่ในหน้าเกี่ยวกับเรา (ไม่ต้องใช้ key) เช่น ชื่อโรงแรม + เมือง หรือ พิกัด 13.7563,100.5018
HOTEL_MAP_QUERY=
