# คัดลอกไฟล์นี้เป็น .env แล้วเปลี่ยนรหัสผ่าน (.\docker.ps1 up สร้างให้อัตโนมัติพร้อมรหัสสุ่ม)
# ไฟล์ .env มีรหัสผ่านจริง ห้ามส่งให้คนอื่นและห้ามใส่ใน ZIP
DB_ROOT_PASSWORD=CHANGE_ME_root
DB_PASSWORD=CHANGE_ME_app
WEB_PORT=8088
DB_HOST_PORT=3317
HOTEL_NAME=AurelleStay
HOTEL_PHONE=
HOTEL_EMAIL=
HOTEL_LINE=
HOTEL_ADDRESS=
# ช่องทางรับเงิน: เบอร์พร้อมเพย์ (10 หลัก) หรือเลขบัตรประชาชน/นิติบุคคล (13 หลัก) → หน้าชำระเงินสร้าง QR ระบุยอดให้อัตโนมัติ
PROMPTPAY_ID=
PAY_ACCOUNT_NAME=
PAY_BANK_NAME=
PAY_ACCOUNT_NO=
# อีเมล (Part 51): ส่งการแจ้งเตือนและลิงก์ลืมรหัสผ่านทางอีเมลจริง — เว้นว่าง = เก็บอีเมลไว้ดูในหน้า "สถานะระบบ"
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=อีเมลของคุณ SMTP_PASSWORD=App Password 16 หลัก (ไม่ใช่รหัส Gmail ปกติ)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# ที่อยู่เว็บที่ใส่ในลิงก์ของอีเมล
PUBLIC_URL=http://localhost:8088
